(kicad_sch (version 20211014) (generator "manual by AI")
  (paper "A4")
  (title_block
    (title "Bandpass Filter 2 MHz, 4th Butterworth, AD8066")
    (company "Пользователь ChatGPT")
  )
  (lib_symbols
    (symbol "Device:R" (pin_names (hide))) ; резисторы
    (symbol "Device:C" (pin_names (hide))) ; конденсаторы
    (symbol "Amplifier_Operational:AD8066")
    (symbol "power:+5V")
    (symbol "power:GND")
    (symbol "power:VREF")
  )
  (components
    (comp (ref "U1") (val "AD8066ARM") (footprint "Housings_SOIC:SOIC-8_3.9x4.9mm_P1.27mm") (sheetpath (name "/")))
    (comp (ref "R1") (val "3.01k")   (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))
    (comp (ref "R2") (val "28.7k")   (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))
    (comp (ref "R3") (val "1.43k")   (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))

    (comp (ref "R4") (val "3.01k")   (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))
    (comp (ref "R5") (val "69.8k")   (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))
    (comp (ref "R6") (val "464")     (footprint "Resistors_SMD:R_0603") (sheetpath (name "/")))

    (comp (ref "C1") (val "15p")     (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))
    (comp (ref "C2") (val "15p")     (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))
    (comp (ref "C3") (val "15p")     (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))
    (comp (ref "C4") (val "15p")     (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))

    (comp (ref "C5") (val "100n")    (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))
    (comp (ref "C6") (val "100n")    (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))

    (comp (ref "CIN") (val "100n")   (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))
    (comp (ref "COUT") (val "100n")  (footprint "Capacitors_SMD:C_0603") (sheetpath (name "/")))

    (comp (ref "VREF") (val "Vref")  (footprint "") (sheetpath (name "/")))
    (comp (ref "+5V") (val "+5V")    (footprint "") (sheetpath (name "/")))
    (comp (ref "GND") (val "GND")    (footprint "") (sheetpath (name "/")))
  )
  ; Пример упрощённой сетки соединений
  (wires
    (wire (start 10 10) (end 30 10)) ; вход -> CIN
    (wire (start 30 10) (end 50 10)) ; CIN -> C1
    (wire (start 50 10) (end 90 10)) ; дальше - первая секция

    ; Здесь опишите все ключевые связи аналогично (см. схему выше в ответах)
    ; Вход -> CIN -> первая секция (R1, C1, C2, R2, R3, opamp U1A, ...)
    ; Первая секция -> C3, C4, R4, R5, R6, opamp U1B -> COUT -> выход

