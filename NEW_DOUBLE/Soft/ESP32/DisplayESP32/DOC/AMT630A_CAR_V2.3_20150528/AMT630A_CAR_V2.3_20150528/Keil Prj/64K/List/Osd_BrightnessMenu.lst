  95          BOOL AdjustBrightness(UCHAR opratComd)
  96          {       
  97   1          if(opratComd == COMD_IncValue)
  98   1          {
  99   2                        if(g_sysSetting.Video.brigthness<MAX_VALUE)
 100   2                        {
 101   3                            g_sysSetting.Video.brigthness++;
 102   3                        } 
 103   2          }
 104   1              if(opratComd == COMD_DecValue)
 105   1              {
 106   2                        if(g_sysSetting.Video.brigthness>0)
 107   2                        {
 108   3                            g_sysSetting.Video.brigthness--;
 109   3                        } 
 110   2              }
 111   1              if(opratComd == COMD_Brightness)
