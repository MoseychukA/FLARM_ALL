  94          BOOL AdjustTint(UCHAR opratComd)
  95          {
  96   1          if(opratComd == COMD_IncValue)
  97   1          {
  98   2              
  99   2                        if(g_sysSetting.Video.tint<MAX_VALUE)
 100   2                        {
 101   3                            g_sysSetting.Video.tint++;
 102   3                        } 
 103   2                        //printf("Inc Value ++ = %d",g_sysSetting.Video.hue);
 104   2          }
