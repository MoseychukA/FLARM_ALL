 114          
 115          BOOL AdjustLanguage(UCHAR opratComd)
 116          {
 117   1              if(opratComd == COMD_IncValue)
 118   1          {     
 119   2                        if(g_sysSetting.Osd.curlanguage <MAX_LANG)
 120   2                        {
 121   3                            g_sysSetting.Osd.curlanguage++;
 122   3                        } 
 123   2                        else
 124   2                        {
 125   3                               g_sysSetting.Osd.curlanguage = MIN_LAG;
 126   3                        }
 127   2                        //printf("curlanguage Inc Value ++ = %d", g_sysSetting.Osd.curlanguage);
 128   2          }
 129   1              if(opratComd == COMD_DecValue)
 130   1              {
 131   2                        if(g_sysSetting.Osd.curlanguage>MIN_LAG)
 132   2                        {
 133   3                            g_sysSetting.Osd.curlanguage--;
 134   3                        } 
 135   2                        else
 136   2                        {
 137   3                               g_sysSetting.Osd.curlanguage = MAX_LANG;
 138   3                        }
 139   2                       //printf("curlanguage Dec Value -- =%d",g_sysSetting.Osd.curlanguage);           
 140   2              }
 141   1              return 1;
 142   1      }
