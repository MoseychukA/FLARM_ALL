  78          SWORD GetQuicklyInputSource(void)
  79          {        
  80   1           switch(g_sysSetting.Video.curSource)
  81   1           {
  82   2                       case INPUT_AV1:
  83   2                                return 0;
  84   2                                
  85   2                       case INPUT_AV2:
  86   2                       case INPUT_CAMERA_Car:
  87   2                                return 1;
  88   2                                
  89   2                       default:
  90   2                                return 0;
  91   2           }
  92   1      }
