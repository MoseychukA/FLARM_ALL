 237          BOOL ExectVideoVcomDc(void)
 238          {
 239   1         //printfStr("ExectVideoVcomDc");
 240   1          switch(VCOMDC_TYPE)
 241   1              {
 242   2                 case PWM0:
 243   2                          SetPWM0(DEFAULT_VCOMDCFREQ,g_sysSetting.Video.vcomDC);
 244   2                              break;
 245   2                              
 246   2                 case PWM1:
 247   2                  SetPWM1(DEFAULT_VCOMDCFREQ,g_sysSetting.Video.vcomDC);
 248   2                              break;
 249   2      
 250   2                 case PWM2:
 251   2                  SetPWM2(DEFAULT_VCOMDCFREQ,g_sysSetting.Video.vcomDC);
 252   2                              break;
 253   2      
 254   2                 case PWM3:
 255   2                  SetPWM3(DEFAULT_VCOMDCFREQ,g_sysSetting.Video.vcomDC);
 256   2                              break;
 257   2                              
 258   2                default:
 259   2                              break;
 260   2              }
 261   1         return 1;
 262   1      }
