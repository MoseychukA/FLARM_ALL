 116          BOOL AdjustVideoVcomDc(UCHAR opratComd)
 117          {
 118   1               if(opratComd == COMD_IncValue)
 119   1           {
 120   2                        if(g_sysSetting.Video.vcomDC<100) 
 121   2                        {
 122   3                            g_sysSetting.Video.vcomDC++;
 123   3                        } 
 124   2           }
 125   1           if(opratComd == COMD_DecValue)
 126   1           {
 127   2                        if(g_sysSetting.Video.vcomDC>0) 
 128   2                        {
 129   3                            g_sysSetting.Video.vcomDC--;
 130   3                        } 
 131   2           }
 132   1               return 1;
 133   1      }
 134          
 135          
 136          BOOL AdjustVideoBrightness(UCHAR opratComd)
 137          {
 138   1          if(opratComd == COMD_IncValue)
 139   1          {
 140   2                      if(g_sysSetting.Video.brightnessOffset < (MAX_VALUE/2+0X14))
 141   2                      {
 142   3                         g_sysSetting.Video.brightnessOffset++;
 143   3                      }
 144   2          }
 145   1              if(opratComd == COMD_DecValue)
 146   1              {
 147   2                  if(g_sysSetting.Video.brightnessOffset > (MAX_VALUE/2-0X14))
 148   2                      {
 149   3                         g_sysSetting.Video.brightnessOffset--;
 150   3                      }
 151   2              }
 152   1              return 1;
 153   1      }
