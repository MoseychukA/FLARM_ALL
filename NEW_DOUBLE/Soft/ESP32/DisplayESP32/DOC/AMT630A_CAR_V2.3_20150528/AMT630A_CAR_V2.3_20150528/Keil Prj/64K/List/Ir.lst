  91          MSG POS_TransferIrKeyMsg(UINT IrKeyVal)
  92          {
  93   1           UCHAR XDATA i;
  94   1               MSG XDATA IrMsg =MSG_NULL;
  95   1               
  96   1              for(i = 0; i < sizeof(SysIrMsgMap)/sizeof(SysIrMsgMap[0]); i++)
  97   1          {
  98   2             if(SysIrMsgMap[i].IrVal == IrKeyVal)        
  99   2             {  
 100   3                   IrMsg = SysIrMsgMap[i].IrMsg;
 101   3             } 
 102   2          }
 103   1          return IrMsg;       
 104   1      }
