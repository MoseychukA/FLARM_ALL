  50          UINT POS_GetRemoteKeyVal(UINT IrVal)
  51          {    
  52   1           UINT XDATA CurrentIr = IR_NULL_KEY;
  53   1      
  54   1           if(CheckReleaseFlg())
  55   1           {
  56   2                        ClrReleaseFlg();
  57   2           }
  58   1              
  59   1               if((IrVal != IR_NULL_KEY)&&(!g_bLogoFlg))
  60   1           {    
  61   2                g_ucRemoteKeyVal = IR_NULL_KEY;
  62   2                        
  63   2                if(CheckRepeatFlg())
  64   2                    {
  65   3                         //printfStr("repeat");
  66   3                         g_UserInputInfo.Status = inputHold;
  67   3                    }  
  68   2                        else
  69   2                        {
  70   3                             //printfStr("no repeat");
  71   3                             g_UserInputInfo.Status = inputPress;
  72   3                        }
  73   2                CurrentIr = IrVal;
  74   2                        //printf("boot current key val =%x", CurrentIr);
  75   2           }
  76   1               return CurrentIr;
  77   1      }
