  84          
  85          BOOL AdjustContrast(UCHAR opratComd)
  86          {
  87   1          if(opratComd == COMD_IncValue)
  88   1          {
  89   2                        if(g_sysSetting.Video.contrast<MAX_VALUE)
  90   2                        {
  91   3                            g_sysSetting.Video.contrast++;
  92   3                        } 
  93   2                        //printf("Inc Value ++ = %d",g_sysSetting.Video.contrast);
  94   2          }
  95   1              if(opratComd == COMD_DecValue)
  96   1              {
  97   2                        if(g_sysSetting.Video.contrast>0)
  98   2                        {
  99   3                            g_sysSetting.Video.contrast--;
 100   3                        } 
 101   2                       //printf("Dec Value -- =%d",g_sysSetting.Video.contrast);
 102   2              }
 103   1              if(opratComd == COMD_Contrast)
 104   1          {     
 105   2                        g_sysSetting.Video.contrast++;
 106   2                        if(g_sysSetting.Video.contrast >MAX_VALUE)
 107   2                        {
 108   3                           g_sysSetting.Video.contrast = 0;
 109   3                        }
 110   2                        //printf("contrast Adjust Value = %d",g_sysSetting.Video.contrast);
 111   2          }
