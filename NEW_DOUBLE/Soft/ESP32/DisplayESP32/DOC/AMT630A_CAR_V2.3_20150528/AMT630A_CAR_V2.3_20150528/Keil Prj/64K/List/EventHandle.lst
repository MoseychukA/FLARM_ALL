 238          void  UserDefinedMsgHandle(MSG curMsg)
 239          {
 240   1          /*关机状态下无倒车*/
 241   1          if(MSG_CAR_POF_GO_AHEAD ==  curMsg)
 242   1          {
 243   2               printfStr("MSG_CAR_POF_GO_AHEAD");
 244   2                       g_sysSetting.Car.DetecMode = AV_CAR_NO_SIGANL; 
 245   2               g_sysSetting.Car.status = CAR_POF_GO_AHEAD;
 246   2                       g_sysSetting.Video.curSource = g_sysSetting.Car.RemberSource;
 247   2                       SetPowerOn();
 248   2               ExectComd(COMD_Power); 
 249   2          }
 250   1      
 251   1              /*开机状态下无倒车*/
 252   1              if(MSG_CAR_PON_GO_AHEAD ==  curMsg)
 253   1          {
 254   2               printfStr("MSG_CAR_PON_GO_AHEAD");
 255   2                       g_sysSetting.Car.DetecMode = AV_CAR_NO_SIGANL; 
 256   2               g_sysSetting.Car.status = CAR_PON_GO_AHEAD;
 257   2                       g_sysSetting.Video.curSource = g_sysSetting.Car.RemberSource; 
 258   2                       SetCarReversingEn();
 259   2                       MenuProcessKey(COMD_SelSource);
 260   2                       ClrCarReversingEn();
 261   2                       if(IsSignalOk())
 262   2                       {
 263   3                          g_sysSetting.Car.DetecMode = AV_SIGNAL_OK; 
 264   3                       }
 265   2          }
 266   1      
 267   1              /*关机状态下倒车*/
 268   1              if(MSG_CAR_POF_REVERSING ==  curMsg)
 269   1          {
 270   2               printfStr("MSG_CAR_POF_REVERSING");
 271   2               g_sysSetting.Video.curSource = INPUT_CAMERA_Car;
 272   2                       g_sysSetting.Car.DetecMode = CAR_SIGNAL_OK;
 273   2               g_sysSetting.Car.status = CAR_POF_REVERSING;
 274   2               SetCarReversingEn();
 275   2               ExectComd(COMD_SelSource);
 276   2                       ClrCarReversingEn();
 277   2                       g_sysSetting.Osd.dispTime= CurrentMenu->TimeOut;
 278   2          }
 279   1      
 280   1              /*开机状态下倒车*/
 281   1              if(MSG_CAR_PON_REVERSING ==  curMsg)
 282   1          {
 283   2               printfStr("MSG_CAR_PON_REVERSING");
 284   2               g_sysSetting.Video.curSource = INPUT_CAMERA_Car;
 285   2                       g_sysSetting.Car.DetecMode = CAR_SIGNAL_OK;
 286   2               g_sysSetting.Car.status = CAR_PON_REVERSING;
 287   2                       SetCarReversingEn();
 288   2               MenuProcessKey(COMD_SelSource);
 289   2                       ClrCarReversingEn();
 290   2              }
 291   1                      
 292   1              /*上电状态倒车*/
 293   1              if(MSG_PON_REVERSING ==  curMsg)  
 294   1              {  
 295   2              printfStr("MSG_PON_REVERSING");
 296   2                  g_sysSetting.Video.curSource = INPUT_CAMERA_Car;
 297   2                  g_sysSetting.Car.DetecMode = CAR_SIGNAL_OK;
C51 COMPILER V9.00   EVENTHANDLE                                                           04/13/2015 11:40:41 PAGE 6   

