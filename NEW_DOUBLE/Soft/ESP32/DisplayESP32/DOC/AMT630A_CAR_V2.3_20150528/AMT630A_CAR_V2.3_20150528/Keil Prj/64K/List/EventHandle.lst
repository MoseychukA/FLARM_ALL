                      if(ucComd!= COMD_Nothing)
                      {
                    g_sysSetting.Osd.storageTime = 0;
                      }
                      #endif//QuickParaSaveEn
  62   1      
  63   1              #ifdef NoSignalPowerOffEn
                      if(ucComd!= COMD_Nothing)
                      {
                     g_ucContNoSignalSecond = 0X00;
                      }
                      #endif
  69   1              
  70   1          MenuProcessKey(ucComd);
  71   1      }
