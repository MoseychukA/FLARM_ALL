  86          BOOL AdjustSaturation(UCHAR opratComd)
  87          {
  88   1          if(opratComd == COMD_IncValue)
  89   1          {
  90   2                        if(g_sysSetting.Video.saturation<MAX_VALUE)
  91   2                        {
  92   3                            g_sysSetting.Video.saturation++;
  93   3                        } 
  94   2                        //printf("Inc Value ++ = %d",g_sysSetting.Video.contrast);
  95   2          }
  96   1              if(opratComd == COMD_DecValue)
  97   1              {
  98   2                        if(g_sysSetting.Video.saturation>0)
  99   2                        {
 100   3                            g_sysSetting.Video.saturation--;
 101   3                        } 
 102   2                       //printf("Dec Value -- =%d",g_sysSetting.Video.contrast);
 103   2              }
 104   1              if(opratComd == COMD_Saturation)
 105   1          {     
 106   2                      g_sysSetting.Video.saturation++;
 107   2                      if(g_sysSetting.Video.saturation >MAX_VALUE)
 108   2                      {
 109   3                         g_sysSetting.Video.saturation = 0;
 110   3                      }
 111   2                  //printf("saturation Adjust Value = %d",g_sysSetting.Video.saturation);
