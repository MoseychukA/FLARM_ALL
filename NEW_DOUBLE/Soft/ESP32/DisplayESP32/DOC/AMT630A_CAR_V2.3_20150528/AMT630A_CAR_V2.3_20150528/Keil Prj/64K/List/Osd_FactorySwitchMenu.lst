 258          BOOL AdjustSystemPowerSwitch(UCHAR opratComd)
 259          {
 260   1          if((opratComd == COMD_IncValue) ||(opratComd == COMD_DecValue))
 261   1          {   
 262   2             switch(g_sysSetting.Factory.powerswitch)
 263   2             {
 264   3                          case OFF:
 265   3                                       g_sysSetting.Factory.powerswitch = ON;
 266   3                                   break;
 267   3                              
 268   3                              case ON:
 269   3                                       g_sysSetting.Factory.powerswitch = SAVE;
 270   3                                   break;
 271   3                              
 272   3                              case SAVE:
 273   3                                       g_sysSetting.Factory.powerswitch = OFF;
 274   3                                   break;
 275   3                                       
 276   3                              default:
 277   3                                      g_sysSetting.Factory.powerswitch = ON;
 278   3                                      break;
 279   3             }           
 280   2                //printf("AdjustPowerSwitch Value = %d",g_sysSetting.Factory.powerswitch);
 281   2          }
 282   1              return 1;
 283   1      }
