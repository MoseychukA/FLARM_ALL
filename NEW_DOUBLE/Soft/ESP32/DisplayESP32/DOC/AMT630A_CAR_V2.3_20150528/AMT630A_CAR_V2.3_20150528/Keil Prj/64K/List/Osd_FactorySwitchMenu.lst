 292   3                                      case LOGO1:
 293   3                                           g_sysSetting.Logo.logoID = LOGO2;
 294   3                                           break;
 295   3      
 296   3                                      case LOGO2:
 297   3                                           g_sysSetting.Logo.logoID = LOGO3;
 298   3                                           break;
 299   3                                               
 300   3                                      case LOGO3:
 301   3                                           g_sysSetting.Logo.logoID = LOGO4;
 302   3                                           break;
 303   3                                               
 304   3                                      case LOGO4:
 305   3                                           g_sysSetting.Logo.logoID = LOGO5;
 306   3                                           break;
 307   3                                               
 308   3                                      case LOGO5:
 309   3                                           g_sysSetting.Logo.logoID = LOGO1;
 310   3                                           break;
 311   3                                               
 312   3                                      default:
 313   3                                           g_sysSetting.Logo.logoID = LOGO1;
 314   3                                           break;
 315   3                              }
 316   2      
 317   2                          if(g_sysSetting.Logo.logoID >(LOGOMAX-1))
 318   2                              {
 319   3                                 g_sysSetting.Logo.logoID = LOGO1;
 320   3                              }
 321   2           }
 322   1               return 1;
 323   1      }
