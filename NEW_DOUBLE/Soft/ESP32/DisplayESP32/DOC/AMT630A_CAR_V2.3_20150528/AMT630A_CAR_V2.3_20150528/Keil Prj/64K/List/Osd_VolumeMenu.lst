  99          BOOL AdjustVolume(UCHAR opratComd)
 100          {
 101   1          if((opratComd == COMD_IncValue)||(opratComd == COMD_IncVolume))
 102   1          {
 103   2                        if(g_sysSetting.Audio.volVal<MAX_VALUE)
 104   2                        {
 105   3                            g_sysSetting.Audio.volVal++;
 106   3                        } 
 107   2                        //printf("volVal Inc Value ++ = %d",g_sysSetting.Audio.volVal);
 108   2          }
 109   1              if((opratComd == COMD_DecValue)||(opratComd == COMD_DecVolume))
 110   1              {
 111   2                  
C51 COMPILER V9.00   OSD_VOLUMEMENU                                                        04/13/2015 11:40:44 PAGE 3   

 112   2                        if(g_sysSetting.Audio.volVal>0)
 113   2                        {
 114   3                            g_sysSetting.Audio.volVal--;
 115   3                        } 
 116   2                       //printf("volVal Dec Value -- =%d",g_sysSetting.Audio.volVal);
 117   2              }
 118   1              return 1;
 119   1      }
