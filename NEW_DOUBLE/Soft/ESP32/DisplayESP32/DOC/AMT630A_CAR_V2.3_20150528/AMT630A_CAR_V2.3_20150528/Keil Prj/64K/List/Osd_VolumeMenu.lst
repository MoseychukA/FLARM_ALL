  60          AdjustType VolumeMenu_CheckCondition(void)
  61          {
  62   1              AdjustType XDATA adjust = {0,0,0};
  63   1      
  64   1              if(ON == g_sysSetting.Factory.volumeswitch)
  65   1              {   
  66   2                      adjust.Flags |= osdVisible;
  67   2                      //printfStr("Volume Visibla");
  68   2              }
  69   1              else
  70   1              {
  71   2                  adjust.Flags |= osdInvisible; 
  72   2                      //printfStr("Volume Invisible");
  73   2              }
  74   1              adjust.XPos= g_sysSetting.Osd.xOffset;
  75   1              adjust.YPos= g_sysSetting.Osd.yOffset;
  76   1              
  77   1              //printfStr("VolumeMenu_CheckCondition");
  78   1              return adjust;
  79   1      }
