 112          BOOL AdjustSys(UCHAR opratComd)
 113          {
 114   1          if((opratComd == COMD_IncValue) ||(opratComd == COMD_DecValue)||(opratComd == COMD_SelSys)) 
 115   1          {     
 116   2             switch(g_sysSetting.Disp.flipMode)
 117   2             {
 118   3               case FilpLeft:
 119   3                                g_sysSetting.Disp.flipMode = FilpRight;
 120   3                                break;
 121   3                                
 122   3                       case FilpRight:
 123   3                               g_sysSetting.Disp.flipMode = FilpUp;
 124   3                                break;
 125   3                                
 126   3                       case FilpUp:
 127   3                                g_sysSetting.Disp.flipMode = FilpDown;
 128   3                                break;
 129   3                                
 130   3                       case FilpDown:
 131   3                                g_sysSetting.Disp.flipMode = FilpLeft;
 132   3                                break;
 133   3                                
 134   3                      default:
 135   3                                g_sysSetting.Disp.flipMode = FilpLeft;
 136   3                                break;
 137   3             }
 138   2                 //printf("AdjustSys Value = %d",g_sysSetting.Disp.flipMode);
 139   2          }
 140   1              return 1;
 141   1      }
