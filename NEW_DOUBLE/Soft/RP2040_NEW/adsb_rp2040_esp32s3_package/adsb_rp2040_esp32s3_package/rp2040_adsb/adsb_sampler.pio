;
.program adsb_sampler
; Sample a single input pin at fixed frequency and push 32-bit words (32 samples)
; sideset and pins configured by init function
; We use in pins, shift right by 1 bit per sample, autopush every 32

.side_set 0

.wrap_target
    in pins, 1      side 0     ; shift 1-bit sample into ISR
    jmp x-- do_push           ; use X as sample counter (32..1)
 do_push:
    push block                ; push ISR->OSR to RX FIFO when autopush triggers (configured in init)
    mov x, isr                ; reload X with 31 (we'll set ISR during init)
.wrap

; Note: init function will set autopush after 32 bits, set shift right, etc.
