; Захват одиночного пина в битовый поток (1 бит на цикл), накапливаем 32 бита и пушим в FIFO.
.program adsb_sampler
; IN base must be configured to target pin externally.
.wrap_target
  set x, 31         ; битов до push
loop:
  in  pins, 1       ; сдвинуть 1 бит в ISR
  jmp x--, loop     ; 32 раза
  push block        ; сбросить 32 бита в FIFO
.wrap
