; PIO программа: семплирует 1 входной пин с частотой SAMPLE_RATE_HZ
; Каждый state machine на свой GPIO, autopush каждые 32 бита
; В ISR набираем через IN PINS, чтобы читать конкретный вход
.program adsb_sampler
; Настройка: set pindirs делается из C++, тут только чтение
; sideset не используется
.wrap_target
sample_loop:
    in pins, 1        ; сдвинуть 1 бит с выбранного pin в ISR (LSB-first по умолчанию)
    jmp x-- sample_loop [0] ; x как простой делитель для тонкой подстройки (опционально)
.wrap

; Установим автосброс/автопуш из C++: shift right, autopush=32
% c-sdk {
#include "hardware/pio.h"
static inline void adsb_sampler_program_init(PIO pio, uint sm, uint offset, uint pin) {
    // Конфиг: один входной pin
    pio_sm_config c = adsb_sampler_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_in_shift(&c, true, true, 32); // shift-right, autopush, threshold=32
    // CLKDIV выставим в C++ по SAMPLE_RATE_HZ
    pio_sm_init(pio, sm, offset, &c);
}
%}
